    "fabric": "^4.5.0",
    "vue": "^2.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@vue/cli-plugin-babel": "^4.5.19",
    "@vue/cli-service": "^4.5.19",
    "core-js": "^3.6.5",
    "fabric": "^4.6.0",
    "less": "^3.13.1",
    "less-loader": "^5.0.0",
    "vue": "2.6.14",
    "vue-template-compiler": "2.6.14"
